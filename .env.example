# --- PostgreSQL (читає docker compose) ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_PORT=5432

# --- API (читає server) ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
PRISMA_LOG=off
DATABASE_URL=postgres://lms:lms_dev_password@localhost:5432/lms
JWT_SECRET=replace-me-with-a-long-random-string-0000000000
COOKIE_SECURE=false
