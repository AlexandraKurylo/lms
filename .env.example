# --- PostgreSQL (читає docker compose) ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
POSTGRES_PORT=5432

# --- API (читає server) ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://lms:lms_dev_password@localhost:5432/lms
# Секрет підпису сесій: щонайменше 32 випадкових символи.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-0000000000
# true, коли сайт відкривається по HTTPS (у продакшені)
COOKIE_SECURE=false
