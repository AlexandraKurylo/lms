{
  "name": "lms-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsx watch --env-file=../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "api:lint": "redocly lint ../openapi/openapi.yaml",
    "format": "prettier --write ..",
    "format:check": "prettier --check ..",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "prisma generate",
    "pretypecheck": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "db:backup": "tsx --env-file=../.env src/backup/backup.ts",
    "db:verify": "tsx --env-file=../.env src/backup/verify.ts",
    "db:restore": "tsx --env-file=../.env src/backup/restore.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx --env-file=../.env src/db/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
