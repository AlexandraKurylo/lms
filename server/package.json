{
  "name": "lms-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ..",
    "format:check": "prettier --check ..",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file=../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "db:reset": "tsx --env-file=../.env src/db/migrate.ts --reset && tsx --env-file=../.env src/db/seed.ts",
    "api:lint": "redocly lint ../openapi/openapi.yaml"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
